# Copy to .env (next to docker-compose.yml) and fill in what you need.
PORT=8080
APP_URL=http://localhost:8080
DB_PASSWORD=leadengine
REVERB_APP_SECRET=change-me-reverb-secret

# Needed to discover businesses:
GOOGLE_PLACES_API_KEY=
# Optional: better AI summaries (otherwise a rule-based classifier is used):
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
